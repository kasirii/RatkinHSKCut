	<Operation Class="PatchOperationReplace">
		<xpath>Defs/PawnKindDef[@Name="RKBasePawnKind"]</xpath>
		<value>
			<PawnKindDef Name="RKBasePawnKind" ParentName="BasePlayerPawnKind"  Abstract="true">
				<race>Ratkin</race>
				<defaultFactionType>Rakinia</defaultFactionType>
				<combatPower>70</combatPower>
				<minGenerationAge>13</minGenerationAge>
				<maxGenerationAge>35</maxGenerationAge>
				<apparelTags Inherit="false">
					<li>Medieval</li>
				</apparelTags>
				<apparelRequired Inherit="false"/>
				<apparelMoney>
					<min>400</min>
					<max>1200</max>
				</apparelMoney>
				<apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
				<weaponTags Inherit="false"/>
				<invFoodDef>GrilledCheese</invFoodDef>
				<invNutrition>2</invNutrition>
				<apparelIgnoreSeasons>false</apparelIgnoreSeasons>
				<initialResistanceRange>0~3</initialResistanceRange>
				<initialWillRange>0~3</initialWillRange>
				<xenotypeSet MayRequire="Ludeon.RimWorld.Biotech" Inherit="false">
					<xenotypeChances>
						<RK_XenoType_Ratkin>1</RK_XenoType_Ratkin>
					</xenotypeChances>
				</xenotypeSet>
				<useFactionXenotypes>false</useFactionXenotypes>
				<forceNormalGearQuality>false</forceNormalGearQuality>
			</PawnKindDef>
		</value>
	</Operation>
	
